{
  "schema_version": 1,
  "kind": "tiered_content_progression",
  "base_level_source": "WarcraftCampaign.getBaseLevel(faction)",
  "faction_scope": "active-campaign",
  "battle_handoff": {"deterministic":true,"seed_source":"encounter.seed","formation_source":"WarcraftRoster","requires_faction_valid_heroes":true},
  "content": [
    {"id":"quest","label":"Quest","unlock_base_level":1,"automation_base_level":2,"manual":true,"auto_run":true,"party":{"kind":"assignment","supported_sizes":[1,3,5]},"hero_xp":1},
    {"id":"incursion","label":"Incursion","unlock_base_level":2,"automation_base_level":3,"manual":true,"auto_run":true,"party":{"kind":"party","supported_sizes":[5]},"hero_xp":2},
    {"id":"dungeon","label":"Dungeon","unlock_base_level":3,"automation_base_level":4,"manual":true,"auto_run":true,"party":{"kind":"party","supported_sizes":[5]},"hero_xp":3,"catalog":"../dungeons/catalog.json"},
    {"id":"raid","label":"Raid","unlock_base_level":4,"automation_base_level":null,"manual":true,"auto_run":false,"party":{"kind":"raid","supported_sizes":[10]},"hero_xp":0},
    {"id":"siege","label":"Siege","unlock_base_level":5,"automation_base_level":null,"manual":true,"auto_run":false,"party":{"kind":"siege","supported_sizes":[20]},"hero_xp":0}
  ],
  "rules": {"availability_is_cumulative":true,"lower_tiers_remain_available":["quest","incursion","dungeon"],"raid_siege_automation":false}
}
